# Optional local WeChat draft adapter. Copy this file to .env.local and fill it manually.
# Never commit .env.local or paste these values into an Agent conversation.
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Optional independent text planner. Skill mode normally reuses the host Agent
# and does not require these fields.
VISUAL_DIRECTOR_TEXT_PROVIDER=mock
DASHSCOPE_API_KEY=
QWEN_TEXT_MODEL=qwen3.7-max-2026-05-20
QWEN_API_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# Optional image generation. Prefer configuring this through the local settings page.
VISUAL_DIRECTOR_IMAGE_PROVIDER=mock

# OpenAI / Ark / compatible Images API.
IMAGE_API_PROTOCOL=openai
IMAGE_API_ENDPOINT=https://api.openai.com/v1/images/generations
IMAGE_API_MODEL=gpt-image-2
IMAGE_API_SIZE=auto
IMAGE_API_KEY=

# Google Gemini / Nano Banana native Interactions API.
GEMINI_IMAGE_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/interactions
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_SIZE=1K
GEMINI_API_KEY=

# Optional override when the private credential file lives outside the repository.
# VISUAL_DIRECTOR_WECHAT_ENV_FILE=C:\private\wechat.env
# VISUAL_DIRECTOR_ENV_FILE=C:\private\visual-director.env
