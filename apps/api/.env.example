# Optional local image provider. Prefer process-scoped environment variables
# or an untracked .env file. Never commit a real key or expose it to an Agent.
VISUAL_DIRECTOR_IMAGE_PROVIDER=mock
AGNES_API_KEY=
AGNES_IMAGE_ENDPOINT=https://apihub.agnes-ai.com/v1/images/generations
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
AGNES_IMAGE_SIZE=1K
AGNES_IMAGE_TIMEOUT_SECONDS=180
AGNES_IMAGE_RETRY_DELAY_SECONDS=1

# Optional local text planner. The default remains the deterministic rule planner.
VISUAL_DIRECTOR_TEXT_PROVIDER=mock
QWEN_API_KEY=
QWEN_TEXT_MODEL=qwen3.7-max
