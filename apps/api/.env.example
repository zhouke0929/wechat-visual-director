# Optional local image provider. Prefer the local settings page or an untracked
# env file. Never commit a real key or expose it to an Agent.
VISUAL_DIRECTOR_IMAGE_PROVIDER=mock
IMAGE_API_PROTOCOL=openai
IMAGE_API_ENDPOINT=https://api.openai.com/v1/images/generations
IMAGE_API_MODEL=gpt-image-2
IMAGE_API_SIZE=auto
IMAGE_API_KEY=
IMAGE_API_TIMEOUT_SECONDS=180
IMAGE_API_RETRY_DELAY_SECONDS=1

GEMINI_IMAGE_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/interactions
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_SIZE=1K
GEMINI_API_KEY=

# Article planning runs in the host Agent. No local text-provider key is needed.
